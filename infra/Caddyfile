# Front door. Listens on 8080 inside the container (no privileged port needed); the host port is
# set by C2B_HTTP_PORT. For a public deployment put a domain here and remove `auto_https off`.
{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Scripts stay strict ('self' only). Styles allow inline attributes (React/Radix positioning).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Admin (ADR-020): reverse-proxy auth in front of the admin page and its API. The user and the
	# bcrypt hash come from C2B_ADMIN_BASIC_USER / C2B_ADMIN_BASIC_HASH (`make env` or deploy.sh
	# set them). With no hash configured the default below is the hash of a random password that
	# was thrown away, so the paths stay locked. The API then asks for the admin passcode as well.
	@admin path /admin /admin/* /api/admin /api/admin/*
	basic_auth @admin {
		{$C2B_ADMIN_BASIC_USER:admin} {$C2B_ADMIN_BASIC_HASH:$2b$10$PmeyC6wJP6J27pw2BOhteelq8coIWTQTZ9cFUuIr.5BQAL1.3xoFm}
	}

	# Access log to stdout (`make logs`). Caddy redacts the Authorization header.
	log {
		output stdout
		format json
	}

	# API: no response compression here so event streams are never buffered.
	handle_path /api/* {
		request_body {
			# Backstop above the app's own limits (200 MB CAD); the API gives the clear message.
			max_size 300MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 20m
				write_timeout 20m
			}
		}
	}

	handle {
		encode zstd gzip
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
