# Copy to .env (or run `make env`, which fills the secrets with random values).
# .env is git-ignored. Only placeholders belong in this file.

# --- Database ---
POSTGRES_USER=c2b
POSTGRES_DB=c2b
POSTGRES_PASSWORD=change-me

# --- Public HTTP port for the Caddy front door ---
C2B_HTTP_PORT=8080

# --- Container user (match your host user on Linux so data/ stays writable) ---
C2B_UID=1000
C2B_GID=1000

# --- Upload limits (MB) and counts ---
C2B_MAX_CAD_MB=200
C2B_MAX_OTHER_MB=25
C2B_MAX_FILES_PER_JOB=50

# --- cad-worker limits ---
C2B_CAD_TIMEOUT_S=120

# --- LLM keys (used by the router since P5; empty = recorded cassettes only) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Native CAD conversion through Autodesk Platform Services (optional, off when empty) ---
# SolidWorks and Fusion files are sent to Autodesk only with the person's consent per job.
# FREE TIER ONLY: the cap below stops the adapter; it never opts into a paid tier. Check your real
# monthly allowance in the APS console and set the cap at or below it.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
C2B_APS_MONTHLY_CAP=20

# --- Admin page for the rule library (optional, off when the passcode is empty) ---
# Two layers: Caddy basic auth (user + bcrypt hash) and this passcode. `scripts/deploy.sh` sets
# them for you; make a hash with: docker run --rm caddy:2.10-alpine caddy hash-password
C2B_ADMIN_PASSCODE=
C2B_ADMIN_SECRET=change-me
C2B_ADMIN_BASIC_USER=admin
# C2B_ADMIN_BASIC_HASH='$2a$14$...'   (single quotes keep the $ characters literal in .env)
# Token for a metrics scraper (sent as X-Metrics-Token to /api/admin/metrics); empty = admin only.
C2B_METRICS_TOKEN=

# --- Operation ---
# production hides /docs and /openapi.json. Jobs and their files are deleted after this many days.
C2B_ENV=development
C2B_RETENTION_DAYS=30
# Per-IP requests per minute (429 beyond this).
C2B_RATE_JOB_CREATE_PER_MIN=20
C2B_RATE_UPLOAD_PER_MIN=120
C2B_RATE_GENERAL_PER_MIN=600
C2B_RATE_ADMIN_LOGIN_PER_MIN=5
# Backups (scripts/backup.sh): how many to keep.
C2B_BACKUP_KEEP=14
# Optional: a URL that receives a POST with a text message when scripts/healthcheck.sh fails.
C2B_ALERT_WEBHOOK=
